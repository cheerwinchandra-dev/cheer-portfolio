# Settings for local testing with "npm run dev". Copy this file to .env.local,
# or run:  npm run hash-password -- --local
# On Netlify, add the same names under Project configuration -> Environment variables.

# Required: the hash of your admin password (from "npm run hash-password" or /admin/setup)
ADMIN_PASSWORD_HASH=''
# Required on Netlify: your Neon connection string (README step 3).
# Leave empty locally to use the built-in local database in .data/
DATABASE_URL=''
# Optional: GitHub token with public read-only access (more reliable updates)
GITHUB_TOKEN=''
# Optional overrides
# ADMIN_USERNAME='cheerwin'
# GITHUB_USERNAME='cheerwinchandra-dev'
